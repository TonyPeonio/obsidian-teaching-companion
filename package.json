{
  "name": "teaching-companion",
  "version": "0.1.0",
  "description": "Grade submissions against your own rubric notes with a local model: proposed scores, verbatim evidence, draft comments and a grade book, all on your machine.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "grade:live": "esbuild scripts/grade-live.ts --bundle --platform=node --format=cjs --outfile=.e2e/grade-live.cjs --log-level=warning && node .e2e/grade-live.cjs"
  },
  "keywords": [
    "obsidian",
    "grading",
    "rubric",
    "teaching",
    "ollama"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
